#!/bin/sh
# Rejects direct pushes (including deletes and force-pushes) to the shared branches.
# test and review are moved only by the CI pipeline; main only by a pull request.
# Enable once per clone: git config core.hooksPath .githooks

protected="main test review"

while read -r local_ref local_sha remote_ref remote_sha; do
  for branch in $protected; do
    if [ "$remote_ref" = "refs/heads/$branch" ]; then
      echo "pre-push: direct pushes to '$branch' are not allowed. Push your personal branch; the pipeline takes it from there." >&2
      exit 1
    fi
  done
done

exit 0
